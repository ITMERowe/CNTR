# Dependencies
node_modules/

# Build output (CI rebuilds it; native build outputs are ignored in android/ and ios/)
dist/
dist-apk/
*.tsbuildinfo

# Release signing: never commit keystores or their passwords
*.jks
*.keystore
*.p12
keystore.properties

# Environment and logs
.env
.env.*
*.log
npm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Playwright CLI output (may contain credentials)
.playwright-cli/

# graphify backups
*.graphify-bak

# AI tooling and session notes: local to this machine, not part of the app
.claude/
.codex/
.impeccable/
.playwright/
graphify-out/
CLAUDE.md
AGENTS.md
HANDOFF.md
PRODUCT.md
docs/superpowers/
docs/screenshots/
docs/security-review-*.md

# Not needed to build the app: iOS project (never built) and Play Store screenshots
ios/
assets/store/
