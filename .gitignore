# Dependencies
node_modules/

# Build output (CI rebuilds it; native build outputs are ignored in android/ and ios/)
dist/
*.tsbuildinfo

# Release signing: never commit keystores or their passwords
*.jks
*.keystore
keystore.properties

# Environment and logs
.env
.env.*
*.log
npm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Playwright CLI output (may contain credentials)
.playwright-cli/

# graphify: keep the graph (graph.json, GRAPH_REPORT.md, graph.html), not per-machine caches
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
*.graphify-bak

# Impeccable: keep the shared config, not the per-machine hook cache
.impeccable/hook.cache.json
